    m_Metadata:
      m_Items: []
  - m_Id: 23994343661568
    m_Localized: AANVULLENDE INFORMATIE
    m_Metadata:
      m_Items: []
  - m_Id: 24013780066304
    m_Localized: VERZORGD?
    m_Metadata:
      m_Items: []
  - m_Id: 24083887857664
    m_Localized: GIFTIG VOOR DIEREN
    m_Metadata:
      m_Items: []
  - m_Id: 24037784068096
    m_Localized: PLAGEN
    m_Metadata:
      m_Items: []
  - m_Id: 29848300199936
    m_Localized: "Geef elke 2\u20136 weken water en laat de grond tussen de waterbeurten
      volledig\nuitdrogen. "
    m_Metadata:
      m_Items: []
  - m_Id: 29914985439232
    m_Localized: 'Geeft de voorkeur aan helder, indirect licht maar kan wel wat direct
      zonlicht verdragen. '
    m_Metadata:
      m_Items: []
  - m_Id: 29916612829184
    m_Localized: 'Doet het goed in neutrale luchtvochtigheid. '
    m_Metadata:
      m_Items: []
  - m_Id: 29917904674816
    m_Localized: 'Gebruik een goed doorlatende vetplantenmix. '
    m_Metadata:
      m_Items: []
  - m_Id: 29919112634368
    m_Localized: Verdunde meststof.
    m_Metadata:
      m_Items: []
  - m_Id: 29920333176832
    m_Localized: 'Hele lage aanvalgevoeligheid. '
    m_Metadata:
      m_Items: []
  - m_Id: 29922241585152
    m_Localized: 'Licht giftig. '
    m_Metadata:
      m_Items: []
  - m_Id: 30013861961728
    m_Localized: 'Vrouwentongen zijn zeer onderhoudsarm, blijven liever licht wortelgebonden
      en moeten warm worden gehouden. '
    m_Metadata:
      m_Items: []
  - m_Id: 32395714928640
    m_Localized: "Geef elke 7\u201310 dagen water, zodat de grond tussen de waterbeurten
      iets droog wordt. "
    m_Metadata:
      m_Items: []
  - m_Id: 32397140992000
    m_Localized: 'Geeft de voorkeur aan helder, indirect licht. Vermijd direct zonlicht. '
    m_Metadata:
      m_Items: []
  - m_Id: 32399875678208
    m_Localized: 'Gebruik een goed doorlatende potgrond. '
    m_Metadata:
      m_Items: []
  - m_Id: 32398437031936
    m_Localized: 'Doet het goed in hoge luchtvochtigheid. '
    m_Metadata:
      m_Items: []
  - m_Id: 32401154940928
    m_Localized: Gebalanceerde vloeibare meststof.
    m_Metadata:
      m_Items: []
  - m_Id: 32402522284032
    m_Localized: 'Middelmatige aanvalgevoeligheid. '
    m_Metadata:
      m_Items: []
  - m_Id: 32403847684096
    m_Localized: 'Niet-giftig. '
    m_Metadata:
      m_Items: []
  - m_Id: 32541261471744
    m_Localized: "Orchidee\xEBn doen het beste in luchtige potten of potten met uitstekende
      drainage, en ze hebben vaak meer luchtcirculatie nodig."
    m_Metadata:
      m_Items: []
  - m_Id: 34277606858752
    m_Localized: 'Geef elke 7-10 dagen water, zodat de bovenkant van de grond tussen
      de waterbeurten kan uitdrogen. '
    m_Metadata:
      m_Items: []
  - m_Id: 34301803798528
    m_Localized: 'Geeft de voorkeur aan fel, indirect licht, maar kan gemiddeld licht
      aan. Vermijd direct zonlicht. '
    m_Metadata:
      m_Items: []
  - m_Id: 34303099838464
    m_Localized: 'Doet het goed in hoge luchtvochtigheid. '
    m_Metadata:
      m_Items: []
  - m_Id: 34304135831552
    m_Localized: 'Gebruik een goed doorlatende potgrond. '
    m_Metadata:
      m_Items: []
  - m_Id: 34305331208192
    m_Localized: Gebalanceerde vloeibare meststof.
    m_Metadata:
      m_Items: []
  - m_Id: 34306610470912
    m_Localized: 'Hoge aanvalgevoeligheid. '
    m_Metadata:
      m_Items: []
  - m_Id: 34307961036800
    m_Localized: 'Licht giftig. '
    m_Metadata:
      m_Items: []
  - m_Id: 34309361934336
    m_Localized: 'Als klimmers hebben ze een paal of mosstok nodig om grotere, gespleten
      bladeren te stimuleren. '
    m_Metadata:
      m_Items: []
  - m_Id: 119518430273536
    m_Localized: Vergeet niet om je monstera te verzorgen.
    m_Metadata:
      m_Items: []
  - m_Id: 119656326406144
    m_Localized: Vergeet niet om je orchidee te verzorgen.
    m_Metadata:
      m_Items: []
  - m_Id: 119682251399168
    m_Localized: Vergeet niet om je vrouwentong te verzorgen.
    m_Metadata:
      m_Items: []
  - m_Id: 2250904993832960
    m_Localized: WINKEL
    m_Metadata:
