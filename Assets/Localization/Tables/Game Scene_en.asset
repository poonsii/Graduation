    m_Metadata:
      m_Items: []
  - m_Id: 29848300199936
    m_Localized: "Water every 2\u20136 weeks, letting the soil dry out completely
      between waterings. "
    m_Metadata:
      m_Items: []
  - m_Id: 29914985439232
    m_Localized: 'Prefers bright, indirect light but can tolerate some direct sun. '
    m_Metadata:
      m_Items: []
  - m_Id: 29916612829184
    m_Localized: 'Prefers neutral humidity. '
    m_Metadata:
      m_Items: []
  - m_Id: 29917904674816
    m_Localized: 'Use a well-draining succulent mix.  '
    m_Metadata:
      m_Items: []
  - m_Id: 29919112634368
    m_Localized: Diluted fertilizer.
    m_Metadata:
      m_Items: []
  - m_Id: 29920333176832
    m_Localized: 'Very low susceptibility. '
    m_Metadata:
      m_Items: []
  - m_Id: 29922241585152
    m_Localized: 'Mildly toxic. '
    m_Metadata:
      m_Items: []
  - m_Id: 30013861961728
    m_Localized: 'Snake plants are very low-maintenance, prefer to stay slightly
      root-bound, and should be kept warm with good drainage. '
    m_Metadata:
      m_Items: []
  - m_Id: 32395714928640
    m_Localized: "Water every 7\u201310 days, allowing the soil to dry slightly between
      waterings. "
    m_Metadata:
      m_Items: []
  - m_Id: 32397140992000
    m_Localized: 'Prefers bright, indirect light. Avoid direct sunlight. '
    m_Metadata:
      m_Items: []
  - m_Id: 32398437031936
    m_Localized: 'Thrives in high humidity. '
    m_Metadata:
      m_Items: []
  - m_Id: 32399875678208
    m_Localized: 'Use a well-draining potting mix.  '
    m_Metadata:
      m_Items: []
  - m_Id: 32401154940928
    m_Localized: Balanced liquid fertilizer.
    m_Metadata:
      m_Items: []
  - m_Id: 32402522284032
    m_Localized: 'Medium-high susceptibility. '
    m_Metadata:
      m_Items: []
  - m_Id: 32403847684096
    m_Localized: 'Non toxic. '
    m_Metadata:
      m_Items: []
  - m_Id: 32541261471744
    m_Localized: 'Orchids do best in airy pots or containers with excellent drainage,
      and they often need more airflow than typical houseplants. '
    m_Metadata:
      m_Items: []
  - m_Id: 34277606858752
    m_Localized: Water every 7-10 days, allowing the top of the soil to dry out between
      waterings.
    m_Metadata:
      m_Items: []
  - m_Id: 34301803798528
    m_Localized: 'Prefers bright, indirect light, but can handle medium light. Avoid
      direct sunlight. '
    m_Metadata:
      m_Items: []
  - m_Id: 34303099838464
    m_Localized: 'Thrives in high humidity. '
    m_Metadata:
      m_Items: []
  - m_Id: 34304135831552
    m_Localized: Use a well-draining potting mix.
    m_Metadata:
      m_Items: []
  - m_Id: 34305331208192
    m_Localized: Balanced liquid fertilizer.
    m_Metadata:
      m_Items: []
  - m_Id: 34306610470912
    m_Localized: 'High susceptibility. '
    m_Metadata:
      m_Items: []
  - m_Id: 34307961036800
    m_Localized: Mildly toxic.
    m_Metadata:
      m_Items: []
  - m_Id: 34309361934336
    m_Localized: 'As climbers, they require a stake or moss pole as they grow to
      encourage larger, fenestrated (split) leaves. '
    m_Metadata:
      m_Items: []
